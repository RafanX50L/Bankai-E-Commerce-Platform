<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Admin Home Page</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Roboto:wght@500;700&display=swap" rel="stylesheet"> 
    
    <!-- Icon Font Stylesheet -->
     <!-- Bootstrap CSS -->
<!-- <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet"> -->

    <!-- jQuery, Popper.js, and Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.1/xlsx.full.min.js"></script>


    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />

    <!-- Customized Bootstrap Stylesheet -->
    <link href="css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="css/style.css" rel="stylesheet">
    <style>
        /* Styling the bar container */
.bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--secondary-color);
    padding: 15px;
    color: #fff;
    border-radius: 8px;
    background-color: #191C24;
}

/* Left side text styling */
.bar-left h2 {
    margin: 0;
    font-size: 1.5em;
}

.bar-left p {
    margin: 5px 0 0;
    font-size: 0.9em;
    color: #f1f1f1;
}

/* Right side button styling */
.bar-right {
    display: flex;
    gap: 10px;
}



    </style>
</head>

<body>
    <div class="container-fluid position-relative d-flex p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-dark position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->


        <!-- Sidebar Start -->
         <%- include('./sidebar', { activePage: 'dashboard', adminName: 'Rafan' }) %>
        <!-- Sidebar End -->


        <!-- Content Start -->
        <div class="content">
            <!-- Navbar Start -->
             <%- include('./navbar', { formAction: '/admin/Products' }) %>
            <!-- Navbar End -->

            <div class="container-fluid pt-4 px-4">
                <div class="bar">
                    <div class="bar-left">
                        <h2>Sales Report</h2>
                        <p>Sales performance overview</p>
                    </div>
                    <div class="bar-right">
                        <div class="dropdown bg-secondary">
                            <button class="btn btn-outline-info dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                📅 Report 
                            </button>
                            <ul class="dropdown-menu p-3 bg-secondary">
                                <li><a class="dropdown-item" href="#" style="color: red;" onclick="setReportRange('today')">Today</a></li>
                                <li><a class="dropdown-item" href="#" style="color: red;" onclick="setReportRange('7days')">Last 7 Days</a></li>
                                <li><a class="dropdown-item" href="#" style="color: red;" onclick="setReportRange('1month')">Last 1 Month</a></li>
                                <li><a class="dropdown-item" href="#" style="color: red;" onclick="setReportRange('3months')">Last 3 Months</a></li>
                                <li>
                                    <!-- Custom Date Range Picker -->
                                    <div id="customDateRange" class="mt-2">
                                        <label>Custom Date Range:</label>
                                        <div class="d-flex flex-column bg-secondary">
                                            <label for="startDate" class="form-label">Start Date:</label>
                                            <input type="date" id="startDate"   onchange="checkDateOrder()">
                                            
                                            <label for="endDate" class="form-label">End Date:</label>
                                            <input type="date" id="endDate"  onchange="checkDateOrder()">
                                        </div>
                                        <button class="btn btn-primary mt-2 w-100" onclick="applyCustomDateRange()">Apply</button>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-outline-info dropdown-toggle" type="button" id="exportDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                ⬇️ Export Report
                            </button>
                            <div class="dropdown-menu bg-secondary" aria-labelledby="exportDropdown">
                                <a class="dropdown-item" href="#" style="color: red;" id="exportPDF">Export as PDF</a>
                                <a class="dropdown-item" href="#" style="color: red;" id="exportExcel">Export as Excel</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Sale & Revenue Start -->
            <div class="container-fluid pt-4 px-4">
                <div class="row g-4">
                    <div class="col-sm-6 col-xl-3">
                        <div class="bg-secondary rounded d-flex align-items-center justify-content-between p-4">
                            <i class="fa fa-chart-line fa-3x text-primary"></i>
                            <div class="ms-3">
                                <p class="mb-2">Total Revenue</p>
                                <h5 class="mb-0">₹ <%= totalRevenue %></h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="bg-secondary rounded d-flex align-items-center justify-content-between p-4">
                            <i class="fa fa-chart-bar fa-3x text-primary"></i>
                            <div class="ms-3">
                                <p class="mb-2">Total Sale</p>
                                <h5 class="mb-0"><%= totalSales %></h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="bg-secondary rounded d-flex align-items-center justify-content-between p-4">
                            <i class="fa fa-chart-area fa-3x text-primary"></i>
                            <div class="ms-3">
                                <p class="mb-2">Average Order Value</p>
                                <h5 class="mb-0">₹ <%= (totalSales > 0) ? (totalRevenue / totalSales).toFixed(2) : 0 %></h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="bg-secondary rounded d-flex align-items-center justify-content-between p-4">
                            <i class="fa fa-chart-pie fa-3x text-primary"></i>
                            <div class="ms-3">
                                <p class="mb-2">Total Discount Deduction </p>
                                <h5 class="mb-0">₹ <%= totalDiscount %></h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Sale & Revenue End -->


           
            

            <!-- Chart Start -->
            <div class="container-fluid pt-4 px-4">
                
                <div class="row g-4">
                    <div class="col-sm-12 col-xl-6">
                        <div class="bg-secondary rounded h-100 p-4">
                            <h6 class="mb-4">Top 10 Selling Products</h6>
                            <canvas id="top-products-chart"></canvas>
                        </div>
                    </div>
                    
                    <div class="col-sm-12 col-xl-6 mt-4">
                        <div class="bg-secondary rounded h-100 p-4">
                            <h6 class="mb-4">Top 10 Selling Subcategories</h6>
                            <canvas id="top-subcategories-chart"></canvas>
                        </div>
                    </div>
                    <div class="col-sm-12 col-xl-8">
                        <div class="bg-secondary rounded h-100 p-4">
                            <h6 class="mb-4">Single Line Chart</h6>
                            <canvas id="line-chart"></canvas>
                        </div>
                    </div>
                    
                    <div class="col-sm-12 col-xl-4">
                        <div class="bg-secondary rounded h-100 p-4">
                            <h6 class="mb-4">Pie Chart</h6>
                            <canvas id="pie-chart"></canvas>
                        </div>
                    </div>
                    
                </div>
            </div>
            <!-- Chart End -->
             

            <!-- Recent Sales Start -->
            <div class="container-fluid pt-4 px-4">
                <div class="bg-secondary text-center rounded p-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h6 class="mb-0">Recent Salse</h6>
                        <a href="">Show All</a>
                    </div>
                    <div class="table-responsive ">
                        <table class="table text-start align-middle table-bordered table-hover mb-0">
                            <thead>
                                <tr class="text-white">
                                    <th scope="col">S.NO</th>
                                    <th scope="col">Date</th>
                                    <th scope="col">Order ID</th>
                                    <th scope="col">Customer</th>
                                    <th scope="col">Products</th>
                                    <th scope="col">Original Price</th>
                                    <th scope="col">Coupon Applied</th>
                                    <th scope="col">Offer Applied</th>
                                    <th scope="col">Final Amount</th>
                                    <th scope="col">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% orders.forEach((order, index) => { %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td><%= new Date(order.orderDate).toLocaleDateString('en-GB') %></td>
                                        <td><%= order.orderId %></td>
                                        <td><%= order.userId.name %></td>
                                        <td>
                                            <% order.items.forEach(item => { %>
                                                <span><%= item.productName %></span><br>
                                            <% }) %>
                                        </td>
                                        <td>₹ <%= order.subtotal %></td>
                                        <td>₹ <%= order.Coupon_discount %></td>
                                        <td>₹ <%= order.Offer_discount %></td>
                                        <td>₹ <%= order.totalAmount %></td>
                                        <td><%= order.status %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="pagination-controls">
                        <% if (currentPage > 1) { %>
                            <a href="?page=<%= currentPage - 1 %>&reportRange=<%= reportRange %>&startDate=<%= startDate %>&endDate=<%= endDate %>" >◀</a>
                        <% } %>
                        
                        <span>Page <%= currentPage %> of <%= totalPages %></span>

                        <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %>&reportRange=<%= reportRange %>&startDate=<%= startDate %>&endDate=<%= endDate %>" >▶</a>
                        <% } %>
                    </div>



                    
                </div>
            </div>
            <!-- Recent Sales End -->


            <!-- Footer Start -->
            <div class="container-fluid pt-4 px-4">
                <div class="bg-secondary rounded-top p-4">
                    <div class="row">
                        <div class="col-12 col-sm-6 text-center text-sm-start">
                            &copy; <a href="#">Your Site Name</a>, All Right Reserved. 
                        </div>
                        <div class="col-12 col-sm-6 text-center text-sm-end">
                            <!--/*** This template is free as long as you keep the footer author’s credit link/attribution link/backlink. If you'd like to use the template without the footer author’s credit link/attribution link/backlink, you can purchase the Credit Removal License from "https://htmlcodex.com/credit-removal". Thank you for your support. ***/-->
                            Designed By <a href="https://htmlcodex.com">HTML Codex</a>
                            <br>Distributed By: <a href="https://themewagon.com" target="_blank">ThemeWagon</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Footer End -->
        </div>
        <!-- Content End -->


        <!-- Back to Top -->
        <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
    </div>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="lib/chart/chart.min.js"></script>
    <script src="lib/easing/easing.min.js"></script>
    <script src="lib/waypoints/waypoints.min.js"></script>
    <script src="lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="lib/tempusdominus/js/moment.min.js"></script>
    <script src="lib/tempusdominus/js/moment-timezone.min.js"></script>
    <script src="lib/tempusdominus/js/tempusdominus-bootstrap-4.min.js"></script>

    <!-- Template Javascript -->
    <script src="js/main.js"></script>
    <script>
        function setReportRange(range) {
            window.location.href = `/admin/dashboard?reportRange=${range}`;
        }

        function applyCustomDateRange() {
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;

            if (new Date(startDate) > new Date(endDate)) {
                alert("Start Date cannot be later than End Date.");
                return;
            }

            window.location.href = `/admin/dashboard?startDate=${startDate}&endDate=${endDate}`;
        }

        document.getElementById('exportPDF').addEventListener('click', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;

            if (startDate && endDate) {
                urlParams.set('startDate', startDate);
                urlParams.set('endDate', endDate);
            }

            window.location.href = `/admin/export-sales-report?${urlParams.toString()}`;
        });

        document.getElementById('exportExcel').addEventListener('click', async function() {
    // Get existing query parameters from the URL
    const urlParams = new URLSearchParams(window.location.search);

    // Get start and end dates from the input fields
    const startDate = document.getElementById('startDate').value;
    const endDate = document.getElementById('endDate').value;

    // Append custom date range if provided
    if (startDate && endDate) {
        urlParams.set('startDate', startDate); // Append or update startDate
        urlParams.set('endDate', endDate);     // Append or update endDate
    }

    // Log the full query string to check the parameters
    console.log('Final URL Params:', urlParams.toString());

    try {
        // Make the fetch request with updated URL
        const response = await fetch(`/admin/export-sales-report-excel?${urlParams.toString()}`);

        if (!response.ok) {
            throw new Error('Failed to generate the Excel file');
        }

        const blob = await response.blob(); // Get the file as a Blob
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob); // Create a URL for the Blob
        link.download = 'Sales_Report.xlsx'; // Set default download filename
        link.click(); // Programmatically click the link to trigger download

    } catch (error) {
        console.error('Error:', error);
        alert('There was an issue exporting the report: ' + error.message);
    }
});



        function checkDateOrder() {
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;

            if (startDate && endDate && new Date(startDate) > new Date(endDate)) {
                alert("Start Date cannot be later than End Date.");
                document.getElementById('endDate').value = ''; 
            }
        }

        document.querySelector('[onclick="setReportRange(\'7days\')"]').addEventListener('click', () => setReportRange('7days'));
        document.querySelector('[onclick="setReportRange(\'1month\')"]').addEventListener('click', () => setReportRange('1month'));
        document.querySelector('[onclick="setReportRange(\'3months\')"]').addEventListener('click', () => setReportRange('3months'));

        document.querySelector('[onclick="applyCustomDateRange()"]').addEventListener('click', applyCustomDateRange);

        document.getElementById('startDate').addEventListener('change', checkDateOrder);
        document.getElementById('endDate').addEventListener('change', checkDateOrder);

    </script>

    <script>
        (function($) {
            // Chart Global Color
            Chart.defaults.color = "#6C7293";
            Chart.defaults.borderColor = "#000000";
            
            // Assuming `chartData` and `pieChartData` are passed from the backend
            const revenueData = <%- JSON.stringify(chartData.revenueData) %>;
            const salesData = <%- JSON.stringify(chartData.salesData) %>;
            const discountData = <%- JSON.stringify(chartData.discountData) %>;
            
            // Reverse the data so that the latest date appears last in the chart
            const reversedRevenueData = revenueData;
            const reversedSalesData = salesData;
            const reversedDiscountData = discountData;
            
            
            
            // Data for Top 10 Selling Products
                const topProductsLabels = <%- JSON.stringify(topProducts.map(product => product.productName)) %>;
                const topProductsData = <%- JSON.stringify(topProducts.map(product => product.quantitySold)) %>;
        
                // Data for Top 10 Selling Subcategories
                const topSubcategoriesLabels = <%- JSON.stringify(topSubcategories.map(subcategory => subcategory.subcategory)) %>;
                const topSubcategoriesData = <%- JSON.stringify(topSubcategories.map(subcategory => subcategory.totalSales)) %>;
        
                // Bar chart for Top 10 Selling Products
                const ctxProducts = document.getElementById("top-products-chart").getContext("2d");
                new Chart(ctxProducts, {
                    type: "bar",
                    data: {
                        labels: topProductsLabels,
                        datasets: [{
                            label: "Quantity Sold",
                            data: topProductsData,
                            backgroundColor: "rgba(54, 162, 235, 0.7)",
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            x: { title: { display: true, text: "Products" } },
                            y: { title: { display: true, text: "Quantity Sold" }, beginAtZero: true }
                        }
                    }
                });
        
                // Bar chart for Top 10 Selling Subcategories
                const ctxSubcategories = document.getElementById("top-subcategories-chart").getContext("2d");
                new Chart(ctxSubcategories, {
                    type: "bar",
                    data: {
                        labels: topSubcategoriesLabels,
                        datasets: [{
                            label: "Total Sales",
                            data: topSubcategoriesData,
                            backgroundColor: "rgba(255, 99, 132, 0.7)",
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            x: { title: { display: true, text: "Subcategories" } },
                            y: { title: { display: true, text: "Total Sales" }, beginAtZero: true }
                        }
                    }
                });


                
            // Single Line Chart (Daily Revenue, Sales, Discount)
            var ctx3 = $("#line-chart").get(0).getContext("2d");
            var myChart3 = new Chart(ctx3, {
                type: "line",
                data: {
                    labels: reversedRevenueData.map(item => item.period), // Labels will be the dates (reversed)
                    datasets: [
                        {
                            label: "Revenue",
                            fill: false,
                            borderColor: "rgba(235, 22, 22, .7)",
                            backgroundColor: "rgba(235, 22, 22, .7)",
                            data: reversedRevenueData.map(item => item.value)
                        },
                        {
                            label: "Sales",
                            fill: false,
                            borderColor: "rgba(22, 235, 22, .7)",
                            backgroundColor: "rgba(22, 235, 22, .7)",
                            data: reversedSalesData.map(item => item.value)
                        },
                        {
                            label: "Discount",
                            fill: false,
                            borderColor: "rgba(22, 22, 235, .7)",
                            backgroundColor: "rgba(22, 22, 235, .7)",
                            data: reversedDiscountData.map(item => item.value)
                        }
                    ]
                },
                options: {
                    responsive: true
                }
            });
    
            // Pie chart (using `pieChartData` passed from the backend)
            var ctx5 = $("#pie-chart").get(0).getContext("2d");
            var myChart5 = new Chart(ctx5, {
                type: "pie",
                data: {
                    labels: ['Placed', 'Processing', 'Shipped', 'Delivered', 'Cancelled', 'Returned', 'Payment pending'], 
                    datasets: [{
                        backgroundColor: [
                            "rgba(255, 99, 132, 0.7)",   
                            "rgba(54, 162, 235, 0.7)",   
                            "rgba(255, 206, 86, 0.7)",   
                            "rgba(75, 192, 192, 0.7)",   
                            "rgba(153, 102, 255, 0.7)",  
                            "rgba(255, 159, 64, 0.7)",   
                            "rgba(201, 203, 207, 0.7)"   
                        ],
                        data: <%- JSON.stringify(pieChartData) %> 
                    }]
                },
                options: {
                    responsive: true
                }
            });
        })(jQuery);
    </script>
    

</body>

</html>